# Tensorix credentials (the default open-model lineup uses Tensorix exclusively)
TENSORIX_API_KEY=sk-your-tensorix-key-here
TENSORIX_BASE_URL=https://api.tensorix.ai/v1

# OpenRouter credentials — required for VLM workflows (dims_vlm, docs_vlm) and
# any models routed via OpenRouter. Also used for open-model VLM ladder.
# OPENROUTER_API_KEY=sk-or-v1-your-openrouter-key-here
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# OpenAI credentials — required for GPT-5.5 anchor model.
# OPENAI_API_KEY=sk-your-openai-key-here

# Anthropic credentials — required for Claude Opus 4.7 anchor model.
# ANTHROPIC_API_KEY=sk-ant-your-anthropic-key-here
