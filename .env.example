# Tensorix credentials (the default lineup uses Tensorix exclusively)
TENSORIX_API_KEY=sk-your-tensorix-key-here
TENSORIX_BASE_URL=https://api.tensorix.ai/v1

# OpenRouter credentials — OPTIONAL. Only required if you opt into models that
# are hosted on OpenRouter via --models. The default lineup does not need this.
# OPENROUTER_API_KEY=sk-or-v1-your-openrouter-key-here
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
